[user]
	name = Yaniv Savir
	email = yaniv@yanivsavir.com
[credential]
	helper = cache
[core]
	editor = vim
	excludesfile = /Users/Yaniv/.gitignore
	pager = diff-so-fancy | less --tabs=4 -RF

[color "status"]
	added = green
  deleted = magenta
  untracked = yellow
  changed = blue
[init]
	defaultBranch = main
[merge]
    conflictStyle = zdiff3
[interactive]
	diffFilter = diff-so-fancy --patch
