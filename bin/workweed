#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="$HOME/.workweedconfig"

usage() {
    cat >&2 <<'EOF'
Usage:
  workweed                          Browse worktrees of the configured repo.
                                    j/k or arrows navigate, Enter selects, q/Esc quits.
  workweed set-repo <path>          Configure the repo to monitor.
  workweed add <branch> <name>      Create a worktree at <repo>/../worktrees/<name>
                                    checking out <branch>. If <branch> doesn't exist,
                                    creates it from the current HEAD. Runs the
                                    post-create hook if configured.
  workweed remove [-f] <name>       Remove the worktree at <repo>/../worktrees/<name>.
                                    Refuses if the worktree is dirty or the pre-remove
                                    hook fails; pass -f/--force to remove anyway and
                                    skip the hook. Leaves the branch in place.
  workweed set-hook <event> <path>  Configure a hook script for an event. Events:
                                      post-create  runs after `add`, inside the new
                                                   worktree. Non-zero exit is a warning.
                                      pre-remove   runs before `remove`, inside the
                                                   worktree being removed. Non-zero exit
                                                   aborts the removal.
                                    Hooks receive these env vars:
                                      WORKWEED_REPO_PATH, WORKWEED_WORKTREE_PATH,
                                      WORKWEED_BRANCH, WORKWEED_NAME.
EOF
}

read_repo() {
    local repo=""
    if [[ -f "$CONFIG_FILE" ]]; then
        repo=$(git config --file "$CONFIG_FILE" workweed.repo 2>/dev/null) || repo=""
    fi
    if [[ -z "$repo" ]]; then
        echo "No repo configured. Run: workweed set-repo <path>" >&2
        exit 1
    fi
    if [[ ! -d "$repo" ]]; then
        echo "Configured repo path is missing: $repo" >&2
        exit 1
    fi
    printf '%s\n' "$repo"
}

validate_name() {
    local name="$1"
    if [[ "$name" == */* || "$name" == "." || "$name" == ".." || -z "$name" ]]; then
        echo "Invalid worktree name: $name" >&2
        exit 1
    fi
}

worktree_path_for() {
    local repo="$1" name="$2"
    printf '%s\n' "$(dirname "$repo")/worktrees/$name"
}

# Returns 0 if <path> is registered as a worktree of <repo>, 1 otherwise.
is_registered_worktree() {
    local repo="$1" path="$2"
    git -C "$repo" worktree list --porcelain \
        | awk -v t="$path" '$1 == "worktree" && substr($0, 10) == t { found=1 } END { exit !found }'
}

cmd_set_repo() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: workweed set-repo <path>" >&2
        exit 1
    fi
    local input="$1"
    local resolved
    if ! resolved=$(cd "$input" 2>/dev/null && pwd); then
        echo "Not a directory: $input" >&2
        exit 1
    fi
    if ! git -C "$resolved" rev-parse --git-dir >/dev/null 2>&1; then
        echo "Not a git repository: $resolved" >&2
        exit 1
    fi
    git config --file "$CONFIG_FILE" workweed.repo "$resolved"
    echo "Configured repo: $resolved" >&2
}

cmd_set_hook() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: workweed set-hook <event> <path>" >&2
        echo "  Events: post-create, pre-remove" >&2
        exit 1
    fi
    local event="$1"
    local input="$2"
    local config_key
    case "$event" in
        post-create) config_key="workweed.post-create-hook" ;;
        pre-remove)  config_key="workweed.pre-remove-hook" ;;
        *)
            echo "Unknown event: $event (must be post-create or pre-remove)" >&2
            exit 1
            ;;
    esac
    if [[ ! -f "$input" ]]; then
        echo "Not a file: $input" >&2
        exit 1
    fi
    if [[ ! -x "$input" ]]; then
        echo "Not executable: $input" >&2
        exit 1
    fi
    local resolved
    resolved="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
    git config --file "$CONFIG_FILE" "$config_key" "$resolved"
    echo "Configured $event hook: $resolved" >&2
}

# If the caller's cwd is inside any worktree of $repo, echo the SHA of that
# worktree's HEAD. Echo nothing otherwise. Using the SHA (not a branch name)
# means the new branch is anchored to the user's exact commit even when their
# HEAD is detached or on a branch that doesn't exist in the main repo's view.
current_worktree_head() {
    local repo="$1"
    local toplevel
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
    if is_registered_worktree "$repo" "$toplevel"; then
        git rev-parse HEAD 2>/dev/null
    fi
}

# Run the configured hook for <event> from inside <worktree_path>.
# Hook receives env vars:
#   WORKWEED_REPO_PATH, WORKWEED_WORKTREE_PATH, WORKWEED_BRANCH, WORKWEED_NAME
# Returns 0 if no hook is configured or the hook succeeds. Prints a diagnostic
# to stderr and returns non-zero if the hook is not executable or exits
# non-zero. Callers decide whether failure is fatal.
run_hook() {
    local event="$1" repo="$2" worktree_path="$3" branch="$4" name="$5"
    local config_key
    case "$event" in
        post-create) config_key="workweed.post-create-hook" ;;
        pre-remove)  config_key="workweed.pre-remove-hook" ;;
    esac
    local hook
    hook=$(git config --file "$CONFIG_FILE" "$config_key" 2>/dev/null) || return 0
    [[ -z "$hook" ]] && return 0
    if [[ ! -x "$hook" ]]; then
        echo "$event hook is not executable: $hook" >&2
        return 1
    fi
    if ! (
        cd "$worktree_path"
        WORKWEED_REPO_PATH="$repo" \
        WORKWEED_WORKTREE_PATH="$worktree_path" \
        WORKWEED_BRANCH="$branch" \
        WORKWEED_NAME="$name" \
        "$hook" >&2
    ); then
        echo "$event hook exited with non-zero status" >&2
        return 1
    fi
}

cmd_add() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: workweed add <branch> <name>" >&2
        exit 1
    fi
    local branch="$1"
    local name="$2"

    validate_name "$name"

    local repo
    repo=$(read_repo)

    local worktree_path
    worktree_path=$(worktree_path_for "$repo" "$name")
    local worktree_root
    worktree_root=$(dirname "$worktree_path")

    if [[ -e "$worktree_path" ]]; then
        echo "Path already exists: $worktree_path" >&2
        exit 1
    fi

    local -a worktree_args=()
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" \
        || git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        worktree_args=("$worktree_path" "$branch")
    else
        worktree_args=("$worktree_path" "-b" "$branch")
        local base
        base=$(current_worktree_head "$repo")
        if [[ -n "$base" ]]; then
            worktree_args+=("$base")
        fi
    fi

    mkdir -p "$worktree_root"

    if ! git -C "$repo" worktree add "${worktree_args[@]}" >&2; then
        exit 1
    fi

    run_hook post-create "$repo" "$worktree_path" "$branch" "$name" || true

    printf '%s\n' "$worktree_path"
}

cmd_remove() {
    local force=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force) force=1; shift ;;
            --) shift; break ;;
            -*) echo "Unknown flag: $1" >&2; exit 1 ;;
            *) break ;;
        esac
    done

    if [[ $# -lt 1 ]]; then
        echo "Usage: workweed remove [-f] <name>" >&2
        exit 1
    fi
    local name="$1"

    validate_name "$name"

    local repo
    repo=$(read_repo)

    local worktree_path
    worktree_path=$(worktree_path_for "$repo" "$name")

    # Confirm the path is registered as a worktree of $repo before removing,
    # so a stray name can't be turned into an `rm -rf` of an unrelated dir.
    if ! is_registered_worktree "$repo" "$worktree_path"; then
        echo "Not a worktree of $repo: $worktree_path" >&2
        exit 1
    fi

    if (( !force )); then
        local branch=""
        branch=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
        if ! run_hook pre-remove "$repo" "$worktree_path" "$branch" "$name"; then
            echo "Aborting removal. Use -f to skip the hook and force removal." >&2
            exit 1
        fi
    fi

    local -a remove_args=()
    if (( force )); then
        remove_args+=(--force)
    fi
    remove_args+=("$worktree_path")

    git -C "$repo" worktree remove "${remove_args[@]}" >&2
}

list_worktrees() {
    local repo="$1"
    git -C "$repo" worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }'
}

# Print the names of worktrees managed by workweed (basenames under the
# expected worktree root), one per line. Used by shell completion.
cmd_names() {
    local repo
    repo=$(read_repo)
    local root="$(dirname "$repo")/worktrees"
    list_worktrees "$repo" | while IFS= read -r path; do
        if [[ "$path" == "$root/"* ]]; then
            basename "$path"
        fi
    done
}

tui_select() {
    local repo="$1"
    local -a paths=()
    while IFS= read -r line; do
        paths+=("$line")
    done < <(list_worktrees "$repo")

    if [[ ${#paths[@]} -eq 0 ]]; then
        echo "No worktrees found in $repo" >&2
        exit 1
    fi

    # fd 3/4 talk to the terminal so stdout stays free for the chosen path.
    exec 3>/dev/tty 4</dev/tty

    local saved_stty
    saved_stty=$(stty -g <&4)
    stty -echo -icanon min 1 time 0 <&4

    # Alternative screen buffer keeps the user's shell history visible after exit.
    printf '\e[?1049h\e[?25l' >&3

    cleanup() {
        printf '\e[?25h\e[?1049l' >&3 2>/dev/null || true
        stty "$saved_stty" <&4 2>/dev/null || true
        exec 3>&- 4<&- 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM

    local selected=0
    local result=""
    while true; do
        printf '\e[2J\e[H' >&3
        printf 'Worktrees for %s\n' "$repo" >&3
        printf '(j/k navigate, Enter or Ctrl-T select, q quit)\n\n' >&3
        local i
        for i in "${!paths[@]}"; do
            local name
            name=$(basename "${paths[$i]}")
            if [[ $i -eq $selected ]]; then
                printf '  \e[7m> %s\e[0m\n' "$name" >&3
            else
                printf '    %s\n' "$name" >&3
            fi
        done

        local key
        # -d '' makes NUL the delimiter so Enter (\n) is read as data, not consumed as a terminator.
        IFS= read -rsn1 -d '' key <&4 || break
        case "$key" in
            j)
                if (( selected < ${#paths[@]} - 1 )); then
                    selected=$((selected + 1))
                fi
                ;;
            k)
                if (( selected > 0 )); then
                    selected=$((selected - 1))
                fi
                ;;
            $'\n'|$'\r'|$'\x14')
                result="${paths[$selected]}"
                break
                ;;
            q)
                break
                ;;
            $'\e')
                # Distinguish a bare Esc from an arrow-key escape sequence.
                # The timeout needs to be long enough for the terminal to
                # deliver the rest of the CSI sequence after the ESC byte.
                local rest=""
                IFS= read -rsn2 -t 0.05 rest <&4 || true
                case "$rest" in
                    '[A')
                        if (( selected > 0 )); then
                            selected=$((selected - 1))
                        fi
                        ;;
                    '[B')
                        if (( selected < ${#paths[@]} - 1 )); then
                            selected=$((selected + 1))
                        fi
                        ;;
                    '')
                        break
                        ;;
                esac
                ;;
        esac
    done

    # Restore the terminal while saved_stty is still in scope. If left to the
    # EXIT trap, cleanup would fire in global scope where the local is unbound
    # and `set -u` would error before stty restores the terminal.
    cleanup
    trap - EXIT INT TERM

    if [[ -n "$result" ]]; then
        printf '%s\n' "$result"
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        local repo
        repo=$(read_repo)
        tui_select "$repo"
        return
    fi

    case "$1" in
        set-repo)
            shift
            cmd_set_repo "$@"
            ;;
        set-hook)
            shift
            cmd_set_hook "$@"
            ;;
        add)
            shift
            cmd_add "$@"
            ;;
        remove|rm)
            shift
            cmd_remove "$@"
            ;;
        names)
            shift
            cmd_names
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            echo "Unknown command: $1" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
